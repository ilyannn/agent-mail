<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys without an Xcode build setting; the rest is generated (project.yml). -->
<plist version="1.0">
<dict>
	<!-- A menu bar app: no Dock icon or menu bar until it switches to the
	     regular activation policy (Settings › General › Dock icon). -->
	<key>LSUIElement</key>
	<true/>
	<!-- Ask for the Persistent style (Alerts on older macOS), which inline
	     Reply needs. -->
	<key>NSUserNotificationAlertStyle</key>
	<string>alert</string>
	<!-- agent-mail:///thread/<id> shows a thread (AppURL): `agent-mail open`,
	     and so a click on the CLI's notification, sends it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Agent Mail thread</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>agent-mail</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
